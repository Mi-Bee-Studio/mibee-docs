# mibee-docs .gitignore

# AI IDE / agent tool state (never commit; PIT-047)
.zcode/
.claude/
.cursor/
.cursorrules
.continue/
.aider*
.windsurf/
.kiro/
.zed/
.copilot*
.gemini/
.goose/
.roo/
.clinerules
CLAUDE.md
GEMINI.md

# Internal tool caches
.omo/
.codegraph
.sisyphus/
.cache/

# OS junk
.DS_Store
Thumbs.db
*~
*.swp

# Transient artifacts (scratch scripts, build output, captures).
# Every other repo in the workspace carries this; without it `git status`
# is permanently dirty and a scratch file is one `git add -A` away from
# being committed.
tmp/
